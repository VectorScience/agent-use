{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursor Remote",
  "version": "1.0.0",
  "identifier": "com.cursorremote.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Cursor Remote",
        "width": 420,
        "height": 880,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Control Cursor from your phone",
    "longDescription": "Remote control for the Cursor IDE — view the workbench screenshot, browse full conversation history, type and send messages, stop the agent."
  }
}
